# --- Telegram ---
TELEGRAM_BOT_API_TOKEN=123456:ABC...
# From https://my.telegram.org/apps (only for the local Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your user ID (= your private chat ID with the bot). Always allowed, gets error reports.
ADMIN_CHAT_ID=
# Other people allowed to use the bot (comma separated). Transcription costs money.
ALLOWED_USER_IDS=
# ALLOW_EVERYONE=true

# --- Speech to text: OpenAI (default) ---
STT_PROVIDER=openai
STT_API_KEY=sk-...
# STT_MODEL=gpt-transcribe

# --- Groq (OpenAI-compatible) ---
# STT_PROVIDER=openai
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY=gsk_...

# --- ElevenLabs Scribe ---
# STT_PROVIDER=elevenlabs
# STT_MODEL=scribe_v2
# STT_API_KEY=...
# STT_KEYTERMS=Perplexity,Beograd

# --- Self-hosted Whisper (speaches, whisper.cpp server, LocalAI, vLLM) ---
# STT_PROVIDER=openai
# STT_BASE_URL=http://whisper:8000/v1
# STT_MODEL=Systran/faster-whisper-large-v3

# --- Tuning ---
# Default language for everyone (ISO-639 code or auto). Users override with /lang.
# STT_LANGUAGE=auto
# Names and jargon that the model should spell correctly (OpenAI-compatible only).
# STT_PROMPT=Chat in Russian, Serbian and English. Names: Marko, Ana.
# CHUNK_SECONDS=600
# MAX_MEDIA_FILESIZE=2G
# FFMPEG_TIMEOUT_SECONDS=300
# STT_TIMEOUT_SECONDS=300
# BUSINESS_INCLUDE_OWN=false
# RUST_LOG=info
